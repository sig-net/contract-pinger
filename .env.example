# Server Configuration
PORT=3001
NODE_ENV=development
API_SECRET=

# ETHEREUM
SIG_ETH_RPC_URL_SEPOLIA=
SIG_ETH_RPC_URL_MAINNET=
# Ethereum setup requires multiple keys for rotation. We can resue same keys for different networks.
SIG_EVM_SK_1=
SIG_EVM_SK_2=
SIG_EVM_SK_3=
SIG_EVM_SK_4=
SIG_EVM_SK_5=

# SOLANA
#
# Used for both the `dev` and `testnet` environments — the chain-signatures
# programs for both live on Solana devnet.
#
# A dedicated endpoint is required for concurrent bidirectional jobs. The
# public api.devnet.solana.com rate-limits well below what they need, and the
# symptom is web3.js retrying 429s until sign transactions stop confirming.
# One Alchemy key serves every network enabled on it, so the same key as
# SIG_ETH_RPC_URL_SEPOLIA works here:
#   https://solana-devnet.g.alchemy.com/v2/<your_key>
SIG_SOL_RPC_URL_DEV=
SIG_SOL_RPC_URL_MAINNET=

SIG_SOL_SK=

# Optional override. Left unset, signet.js pairs the MPC root key to the
# chain-signatures program address, which is the safe configuration. Setting
# this to one network's key while pointing at another network's program yields
# signatures that recover to an unexpected address, and the symptom is a
# transaction that silently never mines.
# SIG_SOL_ROOT_PUBLIC_KEY=

# BIDIRECTIONAL SIGN/RESPOND LOAD TEST
#
# Concurrent address leases. Each path derives its own Ethereum address with
# its own nonce space, and each one needs Sepolia ETH for gas.
SIG_BIDIRECTIONAL_PATHS=10
SIG_BIDIRECTIONAL_PATH_PREFIX=load

# Jobs started per minute. A job holds its address for about a minute but
# stays alive for up to thirty-five, so arrival rate and concurrency are capped
# separately.
SIG_BIDIRECTIONAL_MAX_REQUESTS_PER_MIN=10
SIG_BIDIRECTIONAL_MAX_JOBS=400

# Finished jobs kept for inspection and for /stats. Bounded so a long-running
# instance does not accumulate them for the life of the process; older ones are
# dropped, so /stats reflects a recent window rather than all time.
SIG_BIDIRECTIONAL_RETAINED_JOBS=1000

# eth_self_transfer  - zero-value self-send, 21k gas, no contract involved
# erc20_zero_transfer - transfer(self, 0), 38k gas, the only mode that
#                       exercises the node's debug_traceTransaction path
SIG_BIDIRECTIONAL_TX_MODE=eth_self_transfer
SIG_BIDIRECTIONAL_ERC20_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Whether the MPC waits for Ethereum finality before reading a result back.
# Widens the respond wait only; the signature wait never touches Ethereum.
SIG_BIDIRECTIONAL_WAITS_FOR_ETH_FINALITY=true
SIG_BIDIRECTIONAL_SIGNATURE_TIMEOUT_MS=300000
SIG_BIDIRECTIONAL_ETH_CONFIRM_TIMEOUT_MS=600000

# Left unset on purpose. The finality flag above only supplies this value's
# default, so setting it explicitly means flipping the flag to false changes
# nothing — the respond leg would still wait 35 minutes.
# SIG_BIDIRECTIONAL_RESPOND_TIMEOUT_MS=2100000

# Confirmations before an address is released back to the pool. One consumes
# the nonce; a second guards against a shallow reorg stranding the next
# transaction behind a nonce gap.
SIG_BIDIRECTIONAL_CONFIRMATIONS=2

# Gas top-ups, drawn from SIG_EVM_SK_1..5. Auto-funding is off by default
# because a sweep spends real ETH; POST /sign_bidirectional/fund runs one on
# demand either way.
SIG_BIDIRECTIONAL_AUTO_FUND=false
SIG_BIDIRECTIONAL_MIN_BALANCE_WEI=2000000000000000
SIG_BIDIRECTIONAL_TOPUP_WEI=10000000000000000
SIG_BIDIRECTIONAL_FUNDING_SWEEP_MS=300000
