# Server Configuration
PORT=3001
NODE_ENV=development
API_SECRET=

# ETHEREUM
SIG_ETH_RPC_URL_SEPOLIA=
SIG_ETH_RPC_URL_MAINNET=
# Ethereum setup requires multiple keys for rotation. We can resue same keys for different networks.
SIG_EVM_SK_1=
SIG_EVM_SK_2=
SIG_EVM_SK_3=
SIG_EVM_SK_4=
SIG_EVM_SK_5=

# SOLANA
#
# Used for both the `dev` and `testnet` environments — the chain-signatures
# programs for both live on Solana devnet.
#
# A dedicated endpoint is required for concurrent bidirectional jobs. The
# public api.devnet.solana.com rate-limits well below what they need, and the
# symptom is web3.js retrying 429s until sign transactions stop confirming.
# One Alchemy key serves every network enabled on it, so the same key as
# SIG_ETH_RPC_URL_SEPOLIA works here:
#   https://solana-devnet.g.alchemy.com/v2/<your_key>
SIG_SOL_RPC_URL_DEV=
SIG_SOL_RPC_URL_MAINNET=

SIG_SOL_SK=

# Optional override. Left unset, signet.js pairs the MPC root key to the
# chain-signatures program address, which is the safe configuration. Setting
# this to one network's key while pointing at another network's program yields
# signatures that recover to an unexpected address, and the symptom is a
# transaction that silently never mines.
#
# Uncompressed SEC1 only: 04 followed by 128 hex characters. Compressed 02/03
# keys are rejected at startup rather than converted somewhere out of sight.
# SIG_SOL_ROOT_PUBLIC_KEY=

# BIDIRECTIONAL SIGN/RESPOND LOAD TEST
#
# Concurrent address leases. Each path derives its own Ethereum address with
# its own nonce space, and each one needs Sepolia ETH for gas.
SIG_BIDIRECTIONAL_PATHS=10
SIG_BIDIRECTIONAL_PATH_PREFIX=load

# Jobs started per minute. A job holds its address for about a minute but
# stays alive for up to thirty-five, so arrival rate and concurrency are capped
# separately.
SIG_BIDIRECTIONAL_MAX_REQUESTS_PER_MIN=10

# Two ceilings, because a job's cost changes at confirmation.
#
# Before it, a job holds one of the derived addresses and a stream of chain
# calls, for roughly a minute. After it, the address is released and the job
# holds only an event subscription — for up to thirty-five minutes, waiting on
# Ethereum finality. There are far more of the second kind: at 10 jobs/minute
# roughly 350 are live at once against a dozen of the first.
#
# One combined cap therefore lets the cheap jobs crowd out the expensive ones,
# and its sustainable arrival rate works out to the cap divided by the respond
# budget rather than anything to do with how many addresses exist.
#
# Holding an address: bounded by the pool and chain throughput.
SIG_BIDIRECTIONAL_MAX_ACTIVE_JOBS=20
# Awaiting the respond: bounded by what the Solana endpoint tolerates, since
# signet.js runs a subscription and a backfill loop per wait. This is the one
# that a shared event dispatcher would raise.
SIG_BIDIRECTIONAL_MAX_JOBS=400

# Finished jobs kept for inspection and for /stats. Bounded so a long-running
# instance does not accumulate them for the life of the process; older ones are
# dropped, so /stats reflects a recent window rather than all time.
SIG_BIDIRECTIONAL_RETAINED_JOBS=1000

# eth_self_transfer  - zero-value self-send, 21k gas, no contract involved
# erc20_zero_transfer - transfer(self, 0), 38k gas, the only mode that
#                       exercises the node's debug_traceTransaction path
SIG_BIDIRECTIONAL_TX_MODE=eth_self_transfer

# Overrides the ERC20 for erc20_zero_transfer. Left unset, each network uses
# USDC on the Ethereum it settles on — Sepolia for dev and testnet, mainnet for
# mainnet — so this only needs setting to test a different token.
# SIG_BIDIRECTIONAL_ERC20_ADDRESS=

# Whether the MPC waits for Ethereum finality before reading a result back.
# Widens the respond wait only; the signature wait never touches Ethereum.
SIG_BIDIRECTIONAL_WAITS_FOR_ETH_FINALITY=true
SIG_BIDIRECTIONAL_SIGNATURE_TIMEOUT_MS=300000
SIG_BIDIRECTIONAL_ETH_CONFIRM_TIMEOUT_MS=600000

# Left unset on purpose. The finality flag above only supplies this value's
# default, so setting it explicitly means flipping the flag to false changes
# nothing — the respond leg would still wait 35 minutes.
# SIG_BIDIRECTIONAL_RESPOND_TIMEOUT_MS=2100000

# Confirmations before an address is released back to the pool. One consumes
# the nonce; a second guards against a shallow reorg stranding the next
# transaction behind a nonce gap.
SIG_BIDIRECTIONAL_CONFIRMATIONS=2

# How long a job waits for a free address before giving up. A lease lasts about
# as long as signing plus two confirmations — roughly 70s under load — so a
# burst arriving mid-lease waits rather than failing. Watch `lease wait` in the
# load driver's output: rising there means the pool needs more addresses.
SIG_BIDIRECTIONAL_LEASE_WAIT_MS=180000

# Minimum gas an address must hold before the service will lease it. Read-only
# here: the service reports balances and refuses to lease a short address, but
# never spends. Topping up is `pnpm fund` / the Fund Bidirectional Workers
# workflow, which derives the addresses itself and needs no access to this
# service.
# Must not exceed SIG_BIDIRECTIONAL_FUND_MIN_ETH below, or an address between
# the two is stranded: too low to lease, too high to refill.
SIG_BIDIRECTIONAL_MIN_BALANCE_WEI=2000000000000000

# Which network `pnpm test:e2e` targets. Its credentials follow: dev and
# testnet use the Sepolia and devnet URLs above, mainnet their _MAINNET
# counterparts.
# SIG_BIDIRECTIONAL_E2E_ENV=testnet

# Used only by `pnpm fund`, never by the service.
#
# Point the sweep at a running service and it compares its derived addresses
# against what that service reports, refusing to spend when they disagree.
# Unreachable is not an error — deriving locally is what lets funding work
# while the service is down.
# SIG_BIDIRECTIONAL_SERVICE_URL=http://localhost:3001
# SIG_BIDIRECTIONAL_FUNDING_SK=
# SIG_BIDIRECTIONAL_REQUESTER_PUBKEY=      # defaults to SIG_SOL_SK's public key
# SIG_BIDIRECTIONAL_FUND_MIN_ETH=0.002
# SIG_BIDIRECTIONAL_FUND_TOPUP_ETH=0.0035
#
# Spend caps. The script refuses rather than exceeding any of them, so raising
# one has to be deliberate.
# SIG_BIDIRECTIONAL_FUND_MAX_PER_ADDRESS_ETH=0.02
# SIG_BIDIRECTIONAL_FUND_MAX_PER_RUN_ETH=0.1
# SIG_BIDIRECTIONAL_FUND_RESERVE_ETH=0.02
